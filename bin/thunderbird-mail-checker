#!/usr/bin/env python3
"""Local native-messaging bridge for Thunderbird Mail Checker.

No mail credentials or message bodies pass through this bridge. It stores only
the metadata supplied by the companion Thunderbird extension and exposes it
through a user-only Unix socket to the QuickShell widget.
"""
import argparse
import json
import os
import pathlib
import secrets
import socket
import struct
import subprocess
import sys
import time
import queue
import signal
import threading

APP = "thunderbird-mail-checker"
HOST_NAME = "io.github.villainru.thunderbird_mail_checker"
EXTENSION_ID = "thunderbird-mail-checker@villainru.github.io"
ROOT = pathlib.Path(__file__).resolve().parent.parent
STATE_DIR = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / APP
RUNTIME_DIR = pathlib.Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
SOCKET_PATH = RUNTIME_DIR / (APP + ".sock")
STATUS_PATH = STATE_DIR / "status.json"
LEGACY_QUEUE_PATH = STATE_DIR / "queued-actions.json"

def atomic_json(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, ensure_ascii=False, separators=(",", ":")), encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(path)

def load_json(path, fallback):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return fallback

def request_socket(payload, timeout=3):
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(timeout)
    try:
        client.connect(str(SOCKET_PATH))
        client.sendall((json.dumps(payload, ensure_ascii=False) + "\n").encode())
        raw = b""
        while not raw.endswith(b"\n"):
            chunk = client.recv(65536)
            if not chunk: break
            raw += chunk
        return json.loads(raw.decode()) if raw else None
    finally:
        client.close()

def fallback_status():
    status = load_json(STATUS_PATH, {"connected": False, "setupRequired": True, "accounts": [], "unreadTotal": 0})
    status["connected"] = False
    return status

def focus_thunderbird():
    """Focus the existing Thunderbird window, switching to its workspace if needed."""
    try:
        result = subprocess.run(
            ["hyprctl", "-j", "clients"],
            capture_output=True,
            check=False,
            text=True,
            timeout=2,
        )
        if result.returncode:
            return
        clients = json.loads(result.stdout)
        thunderbird = [
            client for client in clients
            if "thunderbird" in (
                str(client.get("class", "")) + " " + str(client.get("initialClass", ""))
            ).lower()
            and client.get("address")
        ]
        if not thunderbird:
            return
        thunderbird.sort(key=lambda client: int(client.get("focusHistoryID", 1 << 30)))
        address = thunderbird[0]["address"]
        subprocess.run(
            ["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{address}" }})'],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=2,
        )
    except (OSError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired):
        pass

def command_status():
    try:
        response = request_socket({"type": "status"})
        if response and response.get("ok"): print(json.dumps(response["status"], ensure_ascii=False)); return 0
    except OSError:
        pass
    print(json.dumps(fallback_status(), ensure_ascii=False)); return 0

def command_action(action, message_id):
    if action not in {"open", "reply", "delete", "spam"}:
        raise SystemExit("unsupported action")
    payload = {"type": "action", "requestId": secrets.token_hex(12), "action": action, "messageId": int(message_id)}
    try:
        response = request_socket(payload)
        if response:
            if response.get("ok") and action == "open":
                focus_thunderbird()
            print(json.dumps(response, ensure_ascii=False))
            return 0 if response.get("ok") else 1
    except OSError:
        pass
    print(json.dumps({"ok": False, "error": "Thunderbird bridge is unavailable"}, ensure_ascii=False)); return 1

def stop_running_native_host():
    """Stop only this plugin's host, including a pre-restart-command host."""
    helper_path = str(ROOT / "bin" / "thunderbird-mail-checker")
    stopped = False
    for process_dir in pathlib.Path("/proc").glob("[0-9]*"):
        try:
            pid = int(process_dir.name)
            if pid == os.getpid():
                continue
            command = process_dir.joinpath("cmdline").read_bytes().split(b"\0")
            arguments = [part.decode("utf-8", "replace") for part in command if part]
            if helper_path not in arguments or "native-host" not in arguments:
                continue
            os.kill(pid, signal.SIGTERM)
            stopped = True
        except (OSError, ValueError):
            continue
    return stopped

def command_restart():
    try:
        response = request_socket({"type": "restart"})
        if response and response.get("ok"):
            print(json.dumps(response, ensure_ascii=False))
            return 0
        # Hosts from before 0.1.8 do not recognize the request. Terminating the
        # exact local host makes Thunderbird reconnect using the current code.
        if response and response.get("error") != "bad request":
            print(json.dumps(response, ensure_ascii=False)); return 1
    except OSError:
        pass
    if stop_running_native_host():
        print(json.dumps({"ok": True, "reconnecting": True}, ensure_ascii=False)); return 0
    print(json.dumps({"ok": False, "error": "Thunderbird bridge is unavailable"}, ensure_ascii=False)); return 1

def read_native(stream):
    header = stream.read(4)
    if len(header) != 4: return None
    size = struct.unpack("<I", header)[0]
    if size > 4 * 1024 * 1024: raise ValueError("native message too large")
    body = stream.read(size)
    if len(body) != size: return None
    return json.loads(body.decode("utf-8"))

def write_native(payload):
    raw = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("<I", len(raw)) + raw)
    sys.stdout.buffer.flush()

def native_host():
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    try: LEGACY_QUEUE_PATH.unlink()
    except FileNotFoundError: pass
    try: SOCKET_PATH.unlink()
    except FileNotFoundError: pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(SOCKET_PATH)); os.chmod(SOCKET_PATH, 0o600); server.listen(8); server.settimeout(0.2)
    pending = {}
    subscribers = set()
    native_ready = False
    inbound = queue.Queue()

    def send_status(client, status):
        client.sendall((json.dumps({"type": "status", "status": status}, ensure_ascii=False) + "\n").encode())

    def broadcast_status(status):
        stale = []
        for subscriber in subscribers:
            try:
                send_status(subscriber, status)
            except OSError:
                stale.append(subscriber)
        for subscriber in stale:
            subscribers.discard(subscriber)
            subscriber.close()

    def read_from_extension():
        try:
            while True:
                message = read_native(sys.stdin.buffer)
                inbound.put(message)
                if message is None:
                    break
        except Exception as error:
            inbound.put({"type": "reader-error", "error": str(error)})

    threading.Thread(target=read_from_extension, daemon=True).start()
    try:
        while True:
            try:
                client, _ = server.accept(); client.settimeout(3)
                raw = b""
                while not raw.endswith(b"\n"):
                    data = client.recv(65536)
                    if not data: break
                    raw += data
                request = json.loads(raw.decode()) if raw else {}
                if request.get("type") == "status":
                    client.sendall((json.dumps({"ok": True, "status": load_json(STATUS_PATH, fallback_status())}, ensure_ascii=False) + "\n").encode()); client.close()
                elif request.get("type") == "subscribe":
                    send_status(client, load_json(STATUS_PATH, fallback_status()))
                    subscribers.add(client)
                elif request.get("type") == "restart":
                    client.sendall(b'{"ok":true}\n'); client.close(); server.close()
                    for subscriber in subscribers: subscriber.close()
                    try: SOCKET_PATH.unlink()
                    except FileNotFoundError: pass
                    # The native-messaging reader blocks on Thunderbird's stdin.
                    # Exit directly so it cannot keep Python alive during a deliberate restart.
                    os._exit(0)
                elif request.get("type") == "action":
                    if native_ready:
                        pending[request["requestId"]] = client
                        write_native(request)
                    else:
                        client.sendall(b'{"ok":false,"error":"Thunderbird bridge is unavailable"}\n'); client.close()
                else:
                    client.sendall(b'{"ok":false,"error":"bad request"}\n'); client.close()
            except socket.timeout:
                pass
            except (OSError, ValueError, json.JSONDecodeError):
                pass
            while True:
                try: message = inbound.get_nowait()
                except queue.Empty: break
                if message is None: return
                kind = message.get("type")
                if kind == "snapshot":
                    status = message.get("status", {})
                    atomic_json(STATUS_PATH, status)
                    broadcast_status(status)
                elif kind == "error":
                    status = load_json(STATUS_PATH, fallback_status())
                    status.update({"connected": True, "setupRequired": False, "lastError": message.get("error", "Unknown extension error")})
                    atomic_json(STATUS_PATH, status)
                    broadcast_status(status)
                elif kind == "ready":
                    native_ready = True
                elif kind == "action-result":
                    client = pending.pop(message.get("requestId"), None)
                    if client:
                        try: client.sendall((json.dumps({"ok": bool(message.get("ok")), "error": message.get("error", "")}, ensure_ascii=False) + "\n").encode())
                        finally: client.close()
    finally:
        for client in pending.values(): client.close()
        for subscriber in subscribers: subscriber.close()
        server.close()
        try: SOCKET_PATH.unlink()
        except FileNotFoundError: pass

def command_setup():
    manifest_dir = pathlib.Path.home() / ".mozilla/native-messaging-hosts"
    native_manifest = {"name": HOST_NAME, "description": "Thunderbird Mail Checker local bridge", "path": str(ROOT / "bin/native-host"), "type": "stdio", "allowed_extensions": [EXTENSION_ID]}
    atomic_json(manifest_dir / (HOST_NAME + ".json"), native_manifest)
    print(json.dumps({"ok": True, "nativeManifest": str(manifest_dir / (HOST_NAME + ".json")), "xpi": str(ROOT / "thunderbird/thunderbird-mail-checker.xpi")}, ensure_ascii=False))

def main():
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status"); sub.add_parser("setup"); sub.add_parser("native-host"); sub.add_parser("restart")
    action = sub.add_parser("action"); action.add_argument("action"); action.add_argument("message_id")
    args = parser.parse_args()
    if args.command == "status": return command_status()
    if args.command == "setup": command_setup(); return 0
    if args.command == "native-host": native_host(); return 0
    if args.command == "restart": return command_restart()
    return command_action(args.action, args.message_id)

if __name__ == "__main__": raise SystemExit(main())
